SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=
SUPERUSER_NAME=Administrador
SUPERUSER_IS_INSTRUCTOR=0
# Opcional: carpeta de datos separada; vacio usa data/.
MECAPLAN_DATA_DIR=
# En desarrollo se permite demo; en produccion queda deshabilitada por defecto.
# Descomenta para deshabilitarla tambien en desarrollo:
# ENABLE_DEMO=0
MAX_UPLOAD_BYTES=10485760
ENABLE_LOCAL_WEBHOOK=0
GITHUB_WEBHOOK_SECRET=

# OneDrive institucional: aplicación Web de Microsoft Entra (secretos solo en .env.local)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Mismo origen donde se inicia sesión en MecaPlan y URI registrado en Microsoft
ONEDRIVE_REDIRECT_URI=http://localhost:3000/api/onedrive/callback
# Opcional: 32 bytes en base64. Si se omite se crea clave local privada en data.
ONEDRIVE_TOKEN_KEY=

# Backend local por defecto; para Supabase usar .env.vercel.example.
MECAPLAN_DATABASE=sqlite
DATABASE_URL=
DATABASE_SSL_CA=
