# Vercel: copiar los valores en Settings > Environment Variables, nunca en NEXT_PUBLIC_*
MECAPLAN_DATABASE=postgres
# Copiar Connection String > Transaction pooler en Supabase. No incluir comillas ni marcadores.
DATABASE_URL=
# CA de Supabase (PEM); acepta saltos de linea o secuencias \n cuando haga falta.
DATABASE_SSL_CA=
ENABLE_DEMO=0
MAX_UPLOAD_BYTES=3145728
# Opcional: dejar los campos Microsoft vacíos para usar solo enlaces manuales.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
ONEDRIVE_REDIRECT_URI=https://TU-DOMINIO/api/onedrive/callback
# La misma clave de 32 bytes base64 que protege los tokens locales; conservarla en cada despliegue.
ONEDRIVE_TOKEN_KEY=
