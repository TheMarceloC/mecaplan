{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-qa/types/**/*.ts",
    ".next-qa/dev/types/**/*.ts",
    ".next-release/types/**/*.ts",
    ".next-release/dev/types/**/*.ts",
    ".next-cloud-qa/types/**/*.ts",
    ".next-cloud-qa/dev/types/**/*.ts",
    ".next-0.4/types/**/*.ts",
    ".next-0.4/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "data",
    "outputs",
    "work",
    "backups",
    "test-results"
  ]
}
